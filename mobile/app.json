{
  "expo": {
    "name": "I Don't Know",
    "slug": "idontknow-dbp",
    "scheme": "idontknow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idontknow.diario",
      "infoPlist": {
        "NSMotionUsageDescription": "Inclina el teléfono para recorrer titulares sin tocar la pantalla."
      }
    },
    "android": {
      "package": "com.idontknow.diario",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#E5E9DC"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear el QR de una noticia para abrirla en el diario.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5E9DC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#17231F"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para entrar a I Don’t Know y confirmar tu suscripción."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "0a32d47f-1514-4f21-ba1f-0cfa0188ea82"
      }
    },
    "owner": "tuskanips-team"
  }
}
